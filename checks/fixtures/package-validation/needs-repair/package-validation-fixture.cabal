cabal-version: 3.0
name: package-validation-fixture
version: 0.1.0
build-type: Simple
license: BSD-3-Clause

flag compatibility-repair
  default: False
  manual: True

library
  hs-source-dirs: src
  exposed-modules: ValidationFixture
  build-depends: base >=4.20 && <5
  default-language: Haskell2010
  if flag(compatibility-repair)
    cpp-options: -DCOMPATIBILITY_REPAIR

executable validation-probe
  hs-source-dirs: app
  main-is: Main.hs
  build-depends: base >=4.20 && <5, package-validation-fixture
  default-language: Haskell2010

test-suite fixture-tests
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  build-depends: base >=4.20 && <5, package-validation-fixture
  default-language: Haskell2010
