cabal-version: 3.0
name: application-incremental
version: 0.1.0.0
build-type: Simple
license: MIT
extra-source-files: message.txt

library
  exposed-modules: Stable, Leaf, Combined, Embedded
  hs-source-dirs: src
  build-depends: base, template-haskell
  default-language: Haskell2010

executable application-incremental
  main-is: Main.hs
  hs-source-dirs: app
  build-depends: base, application-incremental
  default-language: Haskell2010
