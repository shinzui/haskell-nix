cabal-version: 3.0
name: recipe-leaf
version: 1.0
build-type: Simple
license: BSD-3-Clause

flag use-text
  default: False
  manual: True

library
  exposed-modules: RecipeLeaf
  hs-source-dirs: src
  build-depends: base
  default-language: Haskell2010
  if flag(use-text)
    build-depends: text
    cpp-options: -DUSE_TEXT
