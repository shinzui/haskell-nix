cabal-version: 3.0
name: cohort-flags
version: 0.1.0.0
license: BSD-3-Clause
build-type: Simple

flag automatic
  default: False
  manual: False

flag retained
  default: True
  manual: True

library
  exposed-modules: CohortFlags
  default-language: Haskell2010
  build-depends: base >=4 && <5
  if !flag(automatic)
    build-depends: base >=99
