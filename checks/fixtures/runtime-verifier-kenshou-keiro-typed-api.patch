+module Kenshou.Suite.Keiro.Compat (consumerGroup, batchSize, bufferSize) where
+
+import Data.Int (Int32)
+import Numeric.Natural (Natural)
+import Kiroku.Store.Subscription.Types qualified as Types
+import Kiroku.Store.Subscription.Stream qualified as Stream
+
+consumerGroup :: Int32 -> Int32 -> Types.ConsumerGroup
+consumerGroup member size = either (error . show) id (Types.mkConsumerGroupSize size >>= Types.mkConsumerGroup member)
+
+batchSize :: Int32 -> Types.BatchSize
+batchSize = either (error . show) id . Types.mkBatchSize
+
+bufferSize :: Natural -> Stream.StreamBufferSize
+bufferSize = either (error . show) id . Stream.mkStreamBufferSize
