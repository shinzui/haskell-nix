-- Initial broad cohort solve. Recorded inputs; routine updates retain this index-state.
with-compiler: ghc-9.12.4
index-state: hackage.haskell.org 2026-10-06T04:46:00Z
tests: False
benchmarks: False

constraints:
  crypton >= 1.1,
  http-client-tls >= 0.4,
  -- Limit the monad-control compatibility exception below to the verified 0.8 line.
  transformers-compat <0.9,
  -- Limit the servant-openapi-hs exceptions to the verified dependency lines.
  QuickCheck <2.19,
  base-compat <0.16,
  dhall -use-http-client-tls,
  blake3 -avx512 -avx2 -sse41 -sse2

package blake3
  ghc-options: -optc-DBLAKE3_USE_NEON=0

-- mori://shinzui/rei: Package-qualified allow-newer. mori://shinzui/rei/okf/adrs/concepts/ADR-16 requires each entry to name the bound it
-- mori://shinzui/rei: lifts and what declared it, why the breakage does not reach Rei, the evidence
-- mori://shinzui/rei: that was run, and the release that retires it. mori://shinzui/rei/plans/228-delete-the-tan-residue-and-gate-the-dependency-closure brought the block to
-- mori://shinzui/rei: that standard and deleted the six entries whose removal no longer changed the
-- mori://shinzui/rei: solved plan: proto-lens:base, proto-lens:ghc-prim, proto-lens:deepseq,
-- mori://shinzui/rei: proto-lens-runtime:base, http-conduit:http-client-tls, and haxl:time (haxl is not
-- mori://shinzui/rei: in the install plan at all). Evidence for the deletions: `cabal build all
-- mori://shinzui/rei: --dry-run` solves with all six absent.
--
-- mori://shinzui/rei: The formatter hoists comments out of a field's value list, so the six
-- mori://shinzui/rei: justifications below cannot sit beside their entries. They appear in the SAME
-- mori://shinzui/rei: ORDER as the list that follows them; keep it that way when adding or removing one.
allow-newer:
  -- fuzzyfind:containers -- lifts the `containers == 0.6.*` upper bound declared by
  -- fuzzyfind 3.0.2. GHC 9.12.4 ships containers 0.7 as a boot library, so the bound
  -- cannot be satisfied by downgrading. fuzzyfind imports only Data.Sequence, whose
  -- API is unchanged across 0.6-to-0.7; that release's breaking changes are in the
  -- Data.Map / Data.IntMap surface fuzzyfind never touches. Evidence: rei-cli builds
  -- and `cabal test all` passes with fuzzyfind linked, and removing the entry makes
  -- the solver reject the plan. Remove when fuzzyfind publishes bounds admitting
  -- containers 0.7.
  -- link-canonical:http-client-tls -- lifts the `http-client-tls >=0.3 && <0.4`
  -- upper bound declared by link-canonical 0.1.0.0. Rei forces http-client-tls >= 0.4
  -- in the constraints block above, because crypton 1.1 (needed by
  -- pg-migrate-import-hasql-migration for legacy MD5 ledger checksums) is only
  -- admitted by http-client-tls 0.4. The 0.3-to-0.4 change is a TLS-manager
  -- construction change; link-canonical calls only `TLS.newTlsManager`, the default
  -- manager, whose signature is unchanged. Evidence: `cabal test all` passes with the
  -- link canonicalisation suite linked. Remove when link-canonical publishes bounds
  -- admitting http-client-tls 0.4.
  -- link-canonical:generic-lens -- lifts the `generic-lens >=2.2 && <2.3` upper bound
  -- declared by link-canonical 0.1.0.0; the plan resolves generic-lens 2.3.0.0.
  -- link-canonical uses only Data.Generics.Labels, the orphan `#field` instances,
  -- which 2.3 leaves unchanged. Evidence: as above -- and removing the entry makes
  -- the solver report `link-canonical => generic-lens>=2.2 && <2.3`. Remove when
  -- link-canonical publishes bounds admitting generic-lens 2.3.
  -- kiroku-cli:http-client-tls -- lifts the same `http-client-tls >=0.3 && <0.4`
  -- bound, declared twice by kiroku-cli 0.2.0.8 (library and executable stanzas),
  -- against the same forced http-client-tls >= 0.4. kiroku-cli imports only
  -- `tlsManagerSettings` and passes it to `newManager`; both are unchanged in 0.4.
  -- Evidence: `just build` and `just test` pass with kiroku-cli in the plan. Remove
  -- when kiroku-cli publishes bounds admitting http-client-tls 0.4.
  -- claude:http-client-tls -- lifts the `http-client-tls >=0.3 && <0.4` upper bound
  -- declared by `claude` 1.5.0, the Anthropic SDK that baikai-claude builds on.
  -- Rei forces http-client-tls >= 0.4 in the constraints block above, because
  -- crypton 1.1 (needed by pg-migrate-import-hasql-migration for legacy MD5 ledger
  -- checksums) is only admitted by http-client-tls 0.4. The 0.3-to-0.4 change is a
  -- TLS-manager construction change that `claude` does not depend on: it uses the
  -- default manager settings only. Evidence: the full rei-core and rei-cli suites,
  -- including the three Baikai backend specs, run on the resolved plan by mori://shinzui/rei/plans/223-adopt-the-released-kioku-host-owned-ai-execution-cohort
  -- and re-run by mori://shinzui/rei/plans/224-source-the-baikai-and-shikumi-release-cohort-from-hackage. Remove when `claude` publishes bounds admitting
  -- http-client-tls 0.4.
  -- baikai-kit:crypton -- lifts the `crypton ^>=1.0` upper bound declared by
  -- baikai-kit 0.4.0.0 (the selected metadata still declares it). Rei forces
  -- crypton >= 1.1 in the constraints block above. crypton 1.1's breaking change is the
  -- switch from `memory` to `ram` for secure byte arrays; baikai-kit uses only the
  -- hashing surface (Crypto.Hash) whose API is unchanged across that boundary.
  -- Evidence: rei-cli builds and its suite passes with baikai-kit linked, and
  -- `rei kit` -- the only consumer -- is exercised by mori://shinzui/rei/plans/223-adopt-the-released-kioku-host-owned-ai-execution-cohort's acceptance and by
  -- mori://shinzui/rei/plans/224-source-the-baikai-and-shikumi-release-cohort-from-hackage's rerun. Remove when baikai-kit publishes bounds admitting crypton 1.1.
  --
  -- Baikai 0.7 admits http-client-tls 0.4 and baikai-claude 0.7 admits crypton 1.1
  -- (>=1.0 && <1.2), so their former exceptions stay retired.
  fuzzyfind:containers,
  link-canonical:http-client-tls,
  link-canonical:generic-lens,
  kiroku-cli:http-client-tls,
  claude:http-client-tls,
  -- mori://MercuryTechnologies/claude/packages/claude: 1.5.0 caps http-api-data
  -- below 0.7. Version 0.7 changes Form storage; Claude uses ToHttpApiData
  -- rather than Form. The disposable coherent solve compiles Claude 1.5.0
  -- against http-api-data 0.7 and http-client-tls 0.4; consumer gates also apply.
  -- Retire when a released Claude SDK admits http-api-data 0.7.
  claude:http-api-data,
  baikai-kit:crypton,
  -- mori://shinzui/mori-rei-app: settei-dhall requires dhall-json 1.7.12.
  -- Its released metadata caps aeson below 2.2, bytestring below 0.12
  -- and text below 2.1. Retain the consumer's three scoped exceptions;
  -- the disposable coherent solve compiles dhall-json 1.7.12 against these versions.
  -- Retire when released dhall-json metadata admits the selected versions.
  dhall-json:aeson,
  dhall-json:bytestring,
  dhall-json:text,
  -- mori://basvandijk/monad-control/packages/monad-control: released 1.0.3.1
  -- requires transformers-compat >=0.3 && <0.8. Reiko's recorded stock solve
  -- already selects 0.8, so lowering it would violate the historical floor.
  -- The released implementation imports no transformers-compat modules; the
  -- 0.8 removals concern old compilers/transformers and Generic APIs it does not use.
  -- Evidence: exact released source builds and 11 transformer/control semantic
  -- checks pass on both 0.7.2 and 0.8 under stock GHC 9.12.4/transformers 0.6.3.0.
  -- Preserve all other bounds. Retire when a published monad-control release or
  -- metadata revision admits transformers-compat 0.8.
  monad-control:transformers-compat,
  -- mori://shinzui/servant-openapi-hs/packages/servant-openapi-hs: released 5.1.0
  -- caps QuickCheck below 2.17 and base-compat below 0.15; fresh stock observations
  -- require 2.18 and 0.15. Full library/executable/spec builds pass on both the
  -- baseline (2.16/0.14.1) and target (2.18/0.15), with 22 examples and 400
  -- generated property cases each. All ten modules retain identical preprocessed
  -- source and exported API; both negative solves reproduce the individual caps.
  -- Preserve released source and all other bounds. Retire each exception when
  -- a published release or metadata revision admits that dependency line.
  servant-openapi-hs:QuickCheck,
  servant-openapi-hs:base-compat


