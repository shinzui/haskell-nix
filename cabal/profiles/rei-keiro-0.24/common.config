-- Initial broad cohort solve. Recorded inputs; routine updates retain this index-state.
with-compiler: ghc-9.12.4
index-state: hackage.haskell.org 2026-11-08T23:20:31Z
tests: False
benchmarks: False

constraints:
  -- The newer index needed by mori://shinzui/kioku 0.12.0.1 includes
  -- mori://composewell/streamly/packages/streamly revision 3; retain
  -- version 0.11.1 and its resolved core version.
  streamly ==0.11.1,
  crypton >= 1.1,
  http-client-tls >= 0.4,
  -- Limit the monad-control compatibility exception below to the verified 0.8 line.
  transformers-compat <0.9,
  -- Limit the servant-openapi-hs exceptions to the verified dependency lines.
  QuickCheck <2.19,
  base-compat <0.16,
  dhall +use-http-client-tls,
  blake3 -avx512 -avx2 -sse41 -sse2

package blake3
  ghc-options: -optc-DBLAKE3_USE_NEON=0

-- Package-qualified allow-newer only, per mori://shinzui/rei/okf/adrs/concepts/ADR-16.
-- Each entry names the bound it lifts, why the change does not reach the
-- dependent, the evidence, and when to retire it.
allow-newer:
  -- fuzzyfind 3.0.2 caps containers at 0.6.*; GHC 9.12.4 boots containers 0.7, so
  -- the cap cannot be met. fuzzyfind uses only Data.Sequence, unchanged in 0.7.
  -- Retire when fuzzyfind admits containers 0.7.
  fuzzyfind:containers,
  -- link-canonical 0.1.0.0 caps http-client-tls <0.4; the constraints above force
  -- 0.4 for crypton 1.1. It calls only the unchanged `newTlsManager`.
  -- Retire when link-canonical admits http-client-tls 0.4.
  link-canonical:http-client-tls,
  -- link-canonical 0.1.0.0 caps generic-lens <2.3. It uses only the
  -- Data.Generics.Labels instances, unchanged in 2.3.
  -- Retire when link-canonical admits generic-lens 2.3.
  link-canonical:generic-lens,
  -- Owned by keiro-runtime generation 8, which declares the same exception; the
  -- selected kiroku-cli 0.3.0.1 already admits http-client-tls <0.5.
  -- Retire with the first runtime generation that drops it.
  kiroku-cli:http-client-tls,
  -- claude 1.5.0 caps http-client-tls <0.4; it uses only default manager settings.
  -- Retire when a released claude SDK admits http-client-tls 0.4.
  claude:http-client-tls,
  -- claude 1.5.0 caps http-api-data <0.7. Version 0.7 changes Form storage;
  -- claude uses ToHttpApiData, not Form.
  -- Retire when a released claude SDK admits http-api-data 0.7.
  claude:http-api-data,
  -- baikai-kit 0.4.0.3 caps crypton ^>=1.0; the constraints above force 1.1, whose
  -- break (memory -> ram secure bytes) misses the Crypto.Hash surface it uses.
  -- Retire when baikai-kit admits crypton 1.1.
  baikai-kit:crypton,
  -- dhall-json 1.7.12 (required by settei-dhall, mori://shinzui/mori-rei-app)
  -- caps aeson <2.2, bytestring <0.12 and text <2.1; the coherent solve compiles
  -- it against the selected versions. Retire when its metadata admits them.
  dhall-json:aeson,
  dhall-json:bytestring,
  dhall-json:text,
  -- monad-control 1.0.3.1 caps transformers-compat <0.8 but imports none of its
  -- modules; semantic checks pass on 0.7.2 and 0.8. The constraints above hold
  -- the 0.8 line. Retire when a monad-control release admits 0.8.
  monad-control:transformers-compat,
  -- servant-openapi-hs 5.1.0 caps QuickCheck <2.17 and base-compat <0.15; builds
  -- and specs pass on both lines with identical API. The constraints above hold
  -- the verified lines. Retire each when a release admits that line.
  servant-openapi-hs:QuickCheck,
  servant-openapi-hs:base-compat


-- Retain the configure helper used by the recorded contributor configurations.
-- Native discovery mode and its owner are recorded with the source policy.
package postgresql-libpq
  flags: -use-pkg-config

