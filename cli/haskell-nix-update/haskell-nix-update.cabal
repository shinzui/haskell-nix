cabal-version: 3.4
name: haskell-nix-update
version: 0.1.0.0
synopsis: Refresh first-party Haskell package channels
description:
  Deterministically refresh and validate the first-party GitHub and Hackage
  package locks used by the haskell-nix flake.
license: BSD-3-Clause
author: shinzui
maintainer: shinzui@users.noreply.github.com
build-type: Simple
data-files:
  test/fixtures/invalid/*.json
  test/fixtures/valid/*.json

common common-options
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-uni-patterns
    -Wincomplete-record-updates
    -Wredundant-constraints
    -fhide-source-paths
    -Wmissing-export-lists
    -Wpartial-fields
    -Wmissing-deriving-strategies

  default-language: GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    OverloadedLabels
    OverloadedStrings

library
  import: common-options
  hs-source-dirs: src
  exposed-modules:
    HaskellNix.Update
    HaskellNix.Update.Catalog
    HaskellNix.Update.Cli
    HaskellNix.Update.Git
    HaskellNix.Update.Hackage
    HaskellNix.Update.Mori
    HaskellNix.Update.Nix
    HaskellNix.Update.PackageLock
    HaskellNix.Update.Plan
    HaskellNix.Update.Process
    HaskellNix.Update.Types
    HaskellNix.Update.Workflow

  build-depends:
    Cabal >=3.12 && <3.17,
    aeson ^>=2.2,
    aeson-pretty ^>=0.8,
    base >=4.20 && <5,
    bytestring ^>=0.12,
    containers ^>=0.7,
    directory ^>=1.3,
    filepath ^>=1.5,
    http-client ^>=0.7,
    http-client-tls >=0.3.6 && <0.5,
    optparse-applicative >=0.19 && <0.20,
    process ^>=1.6,
    temporary ^>=1.3,
    text ^>=2.1,
    transformers ^>=0.6

executable haskell-nix-update
  import: common-options
  main-is: Main.hs
  hs-source-dirs: app
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  build-depends:
    base >=4.20 && <5,
    haskell-nix-update

test-suite haskell-nix-update-test
  import: common-options
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  autogen-modules: Paths_haskell_nix_update
  other-modules: Paths_haskell_nix_update

  build-depends:
    Cabal >=3.12 && <3.17,
    aeson ^>=2.2,
    base >=4.20 && <5,
    bytestring ^>=0.12,
    containers ^>=0.7,
    directory ^>=1.3,
    filepath ^>=1.5,
    haskell-nix-update,
    optparse-applicative >=0.19 && <0.20,
    tasty ^>=1.5,
    tasty-hunit ^>=0.10,
    temporary ^>=1.3,
    text ^>=2.1
